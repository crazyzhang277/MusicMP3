<Window x:Class="MusicToMp3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="音乐转 MP3" Height="760" Width="960" MinHeight="680" MinWidth="800"
        Icon="pack://application:,,,/Assets/AppIcon.ico"
        Background="{StaticResource PageBrush}" WindowStartupLocation="CenterScreen"
        AllowDrop="True" PreviewDragOver="Window_PreviewDragOver" PreviewDrop="Window_PreviewDrop">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,22">
            <StackPanel>
                <TextBlock Text="音乐转换" FontFamily="Segoe UI Variable Display" FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
                <TextBlock Text="网易云 NCM 解码与本地 MP3 输出" Margin="0,5,0,0" Foreground="{StaticResource MutedBrush}" />
            </StackPanel>
            <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#E8F4F1" CornerRadius="7" Padding="10,5">
                <TextBlock Text="仅在本机处理" Foreground="#146C62" FontWeight="SemiBold" FontSize="12" />
            </Border>
        </Grid>

        <Border x:Name="DropZoneBorder" Grid.Row="1" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="输入音乐" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
                        <TextBlock Text="支持 .ncm 与常见音频格式" Margin="10,3,0,0" Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                    <TextBlock x:Name="FileCountText" Text="0 个文件" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                </Grid>

                <DockPanel Grid.Row="1" Margin="0,16,0,12">
                    <Button Style="{StaticResource SecondaryButton}" Content="添加文件" Click="AddFiles_Click" />
                    <Button Style="{StaticResource SecondaryButton}" Content="添加文件夹" Click="AddFolder_Click" />
                    <Button Style="{StaticResource QuietButton}" Content="清空列表" Click="Clear_Click" />
                </DockPanel>

                <Grid Grid.Row="2">
                    <ListBox x:Name="FilesList" Style="{StaticResource FileList}" AllowDrop="True"
                             PreviewDragOver="FilesList_PreviewDragOver" PreviewDrop="FilesList_PreviewDrop" />
                    <StackPanel x:Name="DropHint" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock Text="拖入音乐文件" HorizontalAlignment="Center" FontFamily="Segoe UI Variable Display" FontSize="20" FontWeight="SemiBold" Foreground="#53647A" />
                        <TextBlock Text="也可将整个文件夹拖到此处" HorizontalAlignment="Center" Margin="0,7,0,0" Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="2" Margin="0,18,0,16" Padding="20" Background="#FBFCFE" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="输出设置" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />

                <Grid Grid.Row="1" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="OutputPathText" Style="{StaticResource PathTextBox}" />
                    <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="选择目录" Click="ChooseOutput_Click" Margin="10,0,0,0" />
                </Grid>

                <TextBlock Grid.Row="2" Text="转换模式" Margin="0,18,0,8" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <RadioButton x:Name="SmartModeButton" Grid.Column="0" Style="{StaticResource ModeButton}" IsChecked="True" Checked="ConversionMode_Checked">
                        <StackPanel>
                            <TextBlock Text="智能保真" FontWeight="SemiBold" />
                            <TextBlock Text="原 MP3 不二次编码" Margin="0,4,0,0" FontSize="12" Opacity="0.72" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="VbrModeButton" Grid.Column="2" Style="{StaticResource ModeButton}" Checked="ConversionMode_Checked">
                        <StackPanel>
                            <TextBlock Text="高音质省空间" FontWeight="SemiBold" />
                            <TextBlock Text="VBR Q2，约省四成" Margin="0,4,0,0" FontSize="12" Opacity="0.72" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="CbrModeButton" Grid.Column="4" Style="{StaticResource ModeButton}" Checked="ConversionMode_Checked">
                        <StackPanel>
                            <TextBlock Text="固定码率" FontWeight="SemiBold" />
                            <TextBlock Text="精确控制文件大小" Margin="0,4,0,0" FontSize="12" Opacity="0.72" />
                        </StackPanel>
                    </RadioButton>
                </Grid>

                <StackPanel Grid.Row="4" Margin="0,12,0,0">
                    <TextBlock x:Name="ModeDescriptionText" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                               Text="智能保真：NCM 内部本来就是 MP3 时直接导出，不二次压缩，音质与下载文件一致。" />
                    <Border x:Name="FixedBitratePanel" Visibility="Collapsed" Margin="0,12,0,0" Padding="12,10" Background="#F0F6FF" BorderBrush="#BDD2F5" BorderThickness="1" CornerRadius="7">
                        <DockPanel>
                            <TextBlock Text="输出码率" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#204A87" />
                            <ComboBox x:Name="BitrateBox" DockPanel.Dock="Right" Style="{StaticResource BitrateComboBox}" Width="108" MaxDropDownHeight="220" SelectedIndex="3">
                                <ComboBoxItem Content="128k" />
                                <ComboBoxItem Content="192k" />
                                <ComboBoxItem Content="256k" />
                                <ComboBoxItem Content="320k" />
                            </ComboBox>
                            <TextBlock Text="码率越低，文件越小，也更容易损失细节。" Margin="18,2,0,0" Foreground="#42689D" />
                        </DockPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="StatusText" Text="添加音乐文件后开始转换" Foreground="{StaticResource MutedBrush}" />
                <ProgressBar x:Name="Progress" Height="5" Width="330" Margin="0,9,0,0" Minimum="0" Maximum="100" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Style="{StaticResource SecondaryButton}" Content="打开输出目录" Click="OpenOutput_Click" Margin="0,0,10,0" />
                <Button Style="{StaticResource PrimaryButton}" Content="开始转换" Click="Convert_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
