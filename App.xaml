<Application x:Class="MusicToMp3.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="PageBrush" Color="#F4F7FB" />
        <SolidColorBrush x:Key="InkBrush" Color="#172033" />
        <SolidColorBrush x:Key="MutedBrush" Color="#637087" />
        <SolidColorBrush x:Key="BorderBrush" Color="#DCE3ED" />
        <SolidColorBrush x:Key="PrimaryBrush" Color="#0F6CBD" />

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Padding" Value="13,8" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#263247" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#CFD8E6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#F0F6FF" />
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#8BB9E8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#E4EFFC" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Foreground" Value="#637087" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Padding" Value="18,9" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#0F6CBD" />
            <Setter Property="BorderBrush" Value="#0F6CBD" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#0B5CA6" />
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#0B5CA6" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#084A86" />
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#084A86" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox" x:Key="PathTextBox">
            <Setter Property="Padding" Value="11,8" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#263247" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#CFD8E6" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#263247" />
        </Style>

        <Style x:Key="BitrateComboBox" TargetType="ComboBox">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#173B6C" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#9ABCE8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="Toggle" Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Field" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{Binding Padding, RelativeSource={RelativeSource AncestorType=ComboBox}}">
                                            <Grid>
                                                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}" ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}" />
                                                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="Segoe Fluent Icons" FontSize="11" Text="&#xE70D;" Foreground="#3568A7" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Field" Property="Background" Value="#F7FAFF" />
                                                <Setter TargetName="Field" Property="BorderBrush" Value="#528ED4" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Field" Property="Background" Value="#EAF3FF" />
                                                <Setter TargetName="Field" Property="BorderBrush" Value="#0F6CBD" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="Popup" Placement="Bottom" AllowsTransparency="True" PopupAnimation="Fade" IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border Margin="0,5,0,0" Padding="4" Background="White" BorderBrush="#B9CAE0" BorderThickness="1" CornerRadius="7">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#243B5A" BlurRadius="14" ShadowDepth="4" Opacity="0.16" />
                                    </Border.Effect>
                                    <ScrollViewer CanContentScroll="True" Padding="0" SnapsToDevicePixels="True">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Padding" Value="10,8" />
                        <Setter Property="Foreground" Value="#344054" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="ItemSurface" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="ItemSurface" Property="Background" Value="#EEF5FF" />
                                            <Setter Property="Foreground" Value="#0B4F8D" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemSurface" Property="Background" Value="#DCEEFF" />
                                            <Setter Property="Foreground" Value="#0B4F8D" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FileList" TargetType="ListBox">
            <Setter Property="Background" Value="#F8FAFD" />
            <Setter Property="BorderBrush" Value="#DCE3ED" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="5" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#344054" />
        </Style>

        <Style x:Key="ModeButton" TargetType="RadioButton">
            <Setter Property="GroupName" Value="ConversionMode" />
            <Setter Property="Foreground" Value="#344054" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="ModeSurface" Padding="13,12" Background="White" BorderBrush="#DCE3ED" BorderThickness="1" CornerRadius="7">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ModeSurface" Property="BorderBrush" Value="#7EAEE3" />
                                <Setter TargetName="ModeSurface" Property="Background" Value="#F7FAFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ModeSurface" Property="Background" Value="#EAF3FF" />
                                <Setter TargetName="ModeSurface" Property="BorderBrush" Value="#0F6CBD" />
                                <Setter Property="Foreground" Value="#0B4F8D" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ProgressBar">
            <Setter Property="Background" Value="#DCE5F0" />
            <Setter Property="Foreground" Value="#0F6CBD" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </Application.Resources>
</Application>
